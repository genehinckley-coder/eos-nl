# EOS Console — set this to the IP address of your ETC EOS/ION console
# The server starts without it, but OSC sends will fail (sent=false in responses)
EOS_HOST=

# Optional — defaults shown
EOS_PORT=3032
OLLAMA_URL=http://localhost:11434
MODEL_NAME=eos-nl:v4

# Set to false to allow destructive commands (Record, Delete, Update, Label Cue) through
BLOCK_DESTRUCTIVE=true

# Web server bind address and port
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
